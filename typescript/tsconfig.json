{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    // TypeScript 7 loads no @types package unless it is listed here. Without this line,
    // `process` in lexqClient.ts still resolves, but only because @types/express happens
    // to pull in Node's types.
    "types": ["node"],
    "outDir": "dist"
  },
  "include": ["src"]
}
